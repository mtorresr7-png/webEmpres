@page "/cliente"
@rendermode InteractiveServer

@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Administración de Clientes</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Administración de Clientes</h3>
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">
            + Nuevo Cliente
        </button>
    </div>

    <!-- Mensaje de Alerta si hay un Error -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <!-- TABLA DE CLIENTES -->
    @if (clientes == null)
    {
        <div class="alert alert-info" role="alert">
            Cargando clientes...
        </div>
    }
    else if (!clientes.Any())
    {
        <div class="alert alert-warning" role="alert">
            No existen clientes registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <!-- Oculto el ID por seguridad según requerimiento -->
                        <th>CUI</th>
                        <th>NIT</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Fecha Nacimiento</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ClientesPaginados)
                    {
                        <tr>
                            <td>@item.cui</td>
                            <td>@item.nit</td>
                            <td>@item.nombres</td>
                            <td>@item.apellidos</td>
                            <td>@item.direccion</td>
                            <td>@item.telefono</td>
                            <td>@(item.fecha_nacimiento?.ToString("dd/MM/yyyy"))</td>
                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-warning btn-sm me-1"
                                        @onclick="() => AbrirModalEditar(item)">
                                    Editar
                                </button>
                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        @onclick="() => ConfirmarEliminar(item)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- CONTROLES DE PAGINACIÓN -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span>Página @paginaActual de @TotalPaginas (Total: @clientes.Count clientes)</span>
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="PaginaAnterior">Anterior</button>
                    </li>
                    @for (int i = 1; i <= TotalPaginas; i++)
                    {
                        int p = i;
                        <li class="page-item @(paginaActual == p ? "active" : "")">
                            <button class="page-link" @onclick="() => CambiarPagina(p)">@p</button>
                        </li>
                    }
                    <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                        <button class="page-link" @onclick="PaginaSiguiente">Siguiente</button>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- MODAL FORMULARIO (CREAR / EDITAR) -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(editando ? "Editar Cliente" : "Nuevo Cliente")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <EditForm Model="@cliente" OnValidSubmit="GuardarCliente" FormName="ClienteForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">CUI</label>
                                <InputText class="form-control" @bind-Value="cliente.cui" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="cliente.nit" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" @bind-Value="cliente.nombres" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" @bind-Value="cliente.apellidos" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Dirección</label>
                                <InputText class="form-control" @bind-Value="cliente.direccion" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="cliente.telefono" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de nacimiento</label>
                                <InputDate class="form-control" @bind-Value="cliente.fecha_nacimiento" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-success" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            @(editando ? "Actualizar" : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN -->
@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de que desea eliminar al cliente <strong>@clienteAEliminar?.nombres @clienteAEliminar?.apellidos</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">No, Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="EliminarCliente">Sí, Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Clientes>? clientes;
    private Clientes cliente = new();
    private Clientes? clienteAEliminar;

    private bool editando = false;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private bool guardando = false;
    private string? mensajeError;

    // Configuración de Paginación
    private int paginaActual = 1;
    private int registrosPorPagina = 5;

    private int TotalPaginas => (int)Math.Ceiling((double)(clientes?.Count ?? 0) / registrosPorPagina);

    private IEnumerable<Clientes> ClientesPaginados =>
        clientes?.Skip((paginaActual - 1) * registrosPorPagina).Take(registrosPorPagina) ?? Enumerable.Empty<Clientes>();

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    // GET: Cargar clientes de la API
    private async Task CargarClientes()
    {
        try
        {
            mensajeError = null;
            clientes = await Http.GetFromJsonAsync<List<Clientes>>("api/Clientes");
            clientes ??= new List<Clientes>();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de comunicación con la API: {ex.Message}";
            clientes = new List<Clientes>();
        }
    }

    // Modal Formulario Nuevo
    private void AbrirModalNuevo()
    {
        cliente = new Clientes();
        editando = false;
        mostrarModal = true;
    }

    // Modal Formulario Editar
    private void AbrirModalEditar(Clientes item)
    {
        cliente = new Clientes
        {
            Id_cliente = item.Id_cliente,
            cui = item.cui,
            nit = item.nit,
            nombres = item.nombres,
            apellidos = item.apellidos,
            direccion = item.direccion,
            telefono = item.telefono,
            fecha_nacimiento = item.fecha_nacimiento
        };
        editando = true;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    // POST / PUT: Guardar o Actualizar
    private async Task GuardarCliente()
    {
        guardando = true;
        try
        {
            HttpResponseMessage respuesta;

            if (editando)
            {
                // PUT: api/Clientes/{id}
                respuesta = await Http.PutAsJsonAsync($"api/Clientes/{cliente.Id_cliente}", cliente);
            }
            else
            {
                // POST: api/Clientes
                respuesta = await Http.PostAsJsonAsync("api/Clientes", cliente);
            }

            if (respuesta.IsSuccessStatusCode)
            {
                await CargarClientes();
                CerrarModal();
            }
            else
            {
                mensajeError = $"No se pudo guardar el registro. Código de estado: {respuesta.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Excepción al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    // Modal Confirmar Eliminar
    private void ConfirmarEliminar(Clientes item)
    {
        clienteAEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        clienteAEliminar = null;
    }

    // DELETE: Eliminar cliente
    private async Task EliminarCliente()
    {
        if (clienteAEliminar == null) return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/Clientes/{clienteAEliminar.Id_cliente}");

            if (respuesta.IsSuccessStatusCode)
            {
                await CargarClientes();
                if (paginaActual > TotalPaginas && paginaActual > 1)
                {
                    paginaActual--;
                }
            }
            else
            {
                mensajeError = $"No se pudo eliminar el registro. Código de estado: {respuesta.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Excepción al eliminar: {ex.Message}";
        }
        finally
        {
            CerrarModalEliminar();
        }
    }

    // Paginación
    private void CambiarPagina(int pagina) => paginaActual = pagina;
    private void PaginaAnterior() { if (paginaActual > 1) paginaActual--; }
    private void PaginaSiguiente() { if (paginaActual < TotalPaginas) paginaActual++; }

    // Modelo de Clientes
    public class Clientes
    {
        public int Id_cliente { get; set; }
        public string? cui { get; set; }
        public string? nit { get; set; }
        public string? nombres { get; set; }
        public string? apellidos { get; set; }
        public string? direccion { get; set; }
        public string? telefono { get; set; }
        public DateTime? fecha_nacimiento { get; set; }
    }
}